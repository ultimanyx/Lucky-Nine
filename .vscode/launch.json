{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "java",
            "name": "1) Server (Host PC only)",
            "request": "launch",
            "mainClass": "LuckyNineServer",
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "java",
            "name": "2) Client (every PC)",
            "request": "launch",
            "mainClass": "Main",
            "vmArgs": "--module-path \"${workspaceFolder}\\javafx-sdk-27\\lib\" --add-modules javafx.controls,javafx.media",
            "classPaths": ["${workspaceFolder}\\bin", "${workspaceFolder}\\assets"],
            "cwd": "${workspaceFolder}"
        }
    ]
}